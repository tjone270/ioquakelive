<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Early-import properties for submodule dependency projects.
       PlatformToolset must be set before Microsoft.Cpp.Default.props,
       but vcxprojs that explicitly set it will override this.
       Use /p:PlatformToolset=v145 on the MSBuild command line to force. -->
  <PropertyGroup>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
</Project>
